# Supabase Configuration
# Get these values from your Supabase project settings at https://app.supabase.com
VITE_SUPABASE_PROJECT_ID="your_project_id_here"
VITE_SUPABASE_URL="https://your_project_id_here.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_anon_key_here"

# Sentry Error Monitoring (Optional)
# Get your DSN from https://sentry.io/
# This is automatically available if you've added SENTRY_DSN to Lovable secrets
VITE_SENTRY_DSN="your_sentry_dsn_here"

# Instructions:
# 1. Copy this file to .env
# 2. Replace the values with your actual Supabase credentials
# 3. Add your Sentry DSN if you want error monitoring
# 4. Never commit the .env file to version control
# 5. Keep your credentials secure and rotate them regularly

# Note: Meta Pixel ID and Microsoft Clarity ID should be configured in index.html
# as they are public identifiers and need to be in the HTML for tracking to work

# WorkOS SSO selector (koi ek): connection > organization > provider
# VITE_WORKOS_CONNECTION_ID="conn_..."
# VITE_WORKOS_ORGANIZATION_ID="org_..."
# VITE_WORKOS_PROVIDER="authkit"
