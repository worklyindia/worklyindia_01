<resources>
    <style name="WorklyVoiceTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#7EA7FF</item>
        <item name="android:windowBackground">#0B1220</item>
        <item name="android:statusBarColor">#0B1220</item>
        <item name="android:navigationBarColor">#0B1220</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSplashScreenBackground">#0B1220</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_workly_voice</item>
        <item name="android:postSplashScreenTheme">@style/WorklyVoiceTheme</item>
    </style>
</resources>
