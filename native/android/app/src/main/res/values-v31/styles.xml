<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Keep Android 12+ launch theme compatible with the app's current SDK setup.
         The branded full-screen loading UI is shown by MainActivity immediately after launch. -->
    <style name="WorklyLaunchTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@drawable/workly_launch_background</item>
        <item name="android:colorAccent">#159F78</item>
        <item name="android:statusBarColor">#050D1D</item>
        <item name="android:navigationBarColor">#050D1D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
