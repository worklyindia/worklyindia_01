<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WorklyLaunchTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@drawable/workly_launch_background</item>
        <item name="android:colorAccent">#159F78</item>
        <item name="android:statusBarColor">#F4F9FF</item>
        <item name="android:navigationBarColor">#F4F9FF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="WorklyBottomSheetAnimation" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/workly_sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/workly_sheet_exit</item>
    </style>
</resources>