<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WorklyLaunchTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@drawable/workly_launch_background</item>
        <item name="android:windowSplashScreenBackground">#050D1D</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/workly_system_splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">500</item>
        <item name="android:colorAccent">#159F78</item>
        <item name="android:statusBarColor">#050D1D</item>
        <item name="android:navigationBarColor">#050D1D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>