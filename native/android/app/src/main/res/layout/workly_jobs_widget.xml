<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/workly_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/workly_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="WORKLY INDIA" android:textColor="#16A99A" android:textSize="11sp"
            android:textStyle="bold" android:letterSpacing="0.08" />
        <TextView android:id="@+id/workly_widget_refresh" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:padding="5dp" android:text="↻ Refresh"
            android:textColor="#16A99A" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/workly_widget_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:text="Loading latest jobs…" android:textColor="#64748B" android:textSize="11sp" />
    <LinearLayout android:id="@+id/workly_job_1" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="7dp">
        <TextView android:id="@+id/workly_job_1_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Loading opportunities…" android:textColor="#172B4D"
            android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/workly_job_1_meta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#64748B" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1F64748B" />
    <LinearLayout android:id="@+id/workly_job_2" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="7dp" android:paddingBottom="7dp">
        <TextView android:id="@+id/workly_job_2_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#172B4D" android:textSize="13sp"
            android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/workly_job_2_meta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#64748B" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1F64748B" />
    <LinearLayout android:id="@+id/workly_job_3" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="7dp" android:paddingBottom="7dp">
        <TextView android:id="@+id/workly_job_3_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#172B4D" android:textSize="13sp"
            android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/workly_job_3_meta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#64748B" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/workly_widget_button" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="6dp" android:paddingStart="13dp"
        android:paddingEnd="13dp" android:paddingTop="7dp" android:paddingBottom="7dp"
        android:background="@drawable/workly_widget_button" android:text="Browse all jobs  →"
        android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
</LinearLayout>
