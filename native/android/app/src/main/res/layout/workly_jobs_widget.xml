<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/workly_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/workly_widget_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/workly_widget_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Latest opportunities"
            android:textColor="@color/workly_widget_muted"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/workly_widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="↻"
            android:textColor="@color/workly_widget_accent"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/workly_job_1" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="9dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/workly_job_1_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Loading opportunities…" android:textColor="@color/workly_widget_text"
            android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/workly_job_1_meta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/workly_widget_muted" android:textSize="12sp" android:maxLines="1" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/workly_widget_divider" />
    <LinearLayout android:id="@+id/workly_job_2" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/workly_job_2_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/workly_widget_text" android:textSize="14sp"
            android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/workly_job_2_meta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/workly_widget_muted" android:textSize="12sp" android:maxLines="1" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/workly_widget_divider" />
    <LinearLayout android:id="@+id/workly_job_3" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/workly_job_3_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/workly_widget_text" android:textSize="14sp"
            android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/workly_job_3_meta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/workly_widget_muted" android:textSize="12sp" android:maxLines="1" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/workly_widget_button" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingStart="13dp" android:paddingEnd="13dp"
        android:paddingTop="10dp" android:paddingBottom="10dp"
        android:background="@drawable/workly_widget_button" android:gravity="center"
        android:text="Browse all jobs  →" android:textColor="@color/workly_widget_button_text"
        android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
