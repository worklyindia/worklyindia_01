<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/workly_datetime_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/workly_widget_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/workly_datetime_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/workly_widget_greeting_pill"
                android:drawableStart="@drawable/ic_workly_widget_sun"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingStart="13dp"
                android:paddingTop="7dp"
                android:paddingEnd="15dp"
                android:paddingBottom="7dp"
                android:text="Good Afternoon"
                android:textColor="@color/workly_widget_accent"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/workly_datetime_calendar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/workly_widget_calendar_bg"
                android:contentDescription="Open festival calendar"
                android:padding="13dp"
                android:src="@drawable/ic_workly_widget_calendar" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="baseline"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/workly_datetime_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:text="12:30"
                android:textColor="@color/workly_widget_text"
                android:textSize="50sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <TextClock
                android:id="@+id/workly_datetime_seconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:format12Hour="ss"
                android:format24Hour="ss"
                android:includeFontPadding="false"
                android:text="37"
                android:textColor="@color/workly_widget_muted"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <TextView
                android:id="@+id/workly_datetime_ampm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="PM"
                android:textColor="@color/workly_widget_muted"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="serif" />
        </LinearLayout>

        <TextView
            android:id="@+id/workly_datetime_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Monday, 09 November 2026"
            android:textColor="@color/workly_widget_text"
            android:textSize="19sp"
            android:fontFamily="serif" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/workly_widget_divider" />

    <LinearLayout
        android:id="@+id/workly_datetime_festival_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="82dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/workly_widget_festival_icon_bg">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_workly_widget_celebration" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/workly_datetime_festival_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="TODAY'S FESTIVAL"
                android:textColor="@color/workly_widget_muted"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <TextView
                android:id="@+id/workly_datetime_festival_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Festival name"
                android:textColor="@color/workly_widget_text"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="serif" />
        </LinearLayout>

        <TextView
            android:id="@+id/workly_datetime_festival_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/workly_widget_today_pill"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="11dp"
            android:paddingTop="7dp"
            android:paddingEnd="11dp"
            android:paddingBottom="7dp"
            android:text="Today"
            android:textColor="@color/workly_widget_accent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_workly_widget_chevron"
            android:tint="@color/workly_widget_muted" />
    </LinearLayout>
</LinearLayout>
