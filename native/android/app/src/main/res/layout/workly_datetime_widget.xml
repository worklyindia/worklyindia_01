<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/workly_datetime_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/workly_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="INDIA STANDARD TIME"
        android:textColor="@color/workly_widget_accent"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <TextClock
        android:id="@+id/workly_datetime_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:contentDescription="Live India time"
        android:format12Hour="hh:mm:ss a"
        android:format24Hour="HH:mm:ss"
        android:timeZone="Asia/Kolkata"
        android:textColor="@color/workly_widget_primary_text"
        android:textSize="32sp"
        android:fontFamily="sans"
        android:includeFontPadding="false" />

    <TextClock
        android:id="@+id/workly_datetime_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:format12Hour="EEEE, dd MMMM yyyy"
        android:format24Hour="EEEE, dd MMMM yyyy"
        android:timeZone="Asia/Kolkata"
        android:textColor="@color/workly_widget_secondary_text"
        android:textSize="13sp" />

    <View
        android:layout_width="42dp"
        android:layout_height="3dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/workly_widget_accent_line" />
</LinearLayout>
