<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/workly_datetime_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/workly_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/workly_datetime_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/workly_widget_pill"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="☀  Good Afternoon"
            android:textColor="@color/workly_widget_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/workly_datetime_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="@color/workly_widget_primary_text"
                android:textSize="48sp"
                android:textStyle="bold"
                android:timeZone="Asia/Kolkata" />

            <TextClock
                android:id="@+id/workly_datetime_seconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:format12Hour="ss a"
                android:format24Hour="ss"
                android:includeFontPadding="false"
                android:textColor="@color/workly_widget_secondary_text"
                android:textSize="22sp"
                android:timeZone="Asia/Kolkata" />
        </LinearLayout>

        <TextClock
            android:id="@+id/workly_datetime_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:format12Hour="EEEE, dd MMMM yyyy"
            android:format24Hour="EEEE, dd MMMM yyyy"
            android:includeFontPadding="false"
            android:textColor="@color/workly_widget_secondary_text"
            android:textSize="15sp"
            android:timeZone="Asia/Kolkata" />
    </LinearLayout>

    <!-- TextView is supported by RemoteViews; a plain View is not. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/workly_widget_border"
        android:includeFontPadding="false"
        android:text="" />

    <LinearLayout
        android:id="@+id/workly_festival_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="76dp"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/workly_widget_festival_icon"
            android:gravity="center"
            android:text="✧"
            android:textColor="@color/workly_widget_festival_icon_text"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FESTIVALS"
                android:textColor="@color/workly_widget_secondary_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/workly_festival_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Explore festival calendar"
                android:textColor="@color/workly_widget_primary_text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/workly_widget_pill"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text="Open"
            android:textColor="@color/workly_widget_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="›"
            android:textColor="@color/workly_widget_secondary_text"
            android:textSize="30sp" />
    </LinearLayout>
</LinearLayout>
