<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/workly_datetime_root"
 android:layout_width="match_parent"
 android:layout_height="match_parent"
 android:orientation="vertical"
 android:paddingStart="14dp"
 android:paddingTop="10dp"
 android:paddingEnd="14dp"
 android:paddingBottom="6dp">
 <TextView
  android:id="@+id/workly_datetime_greeting"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:text="☀  Good Afternoon"
  android:textColor="#FFFFFFFF"
  android:shadowColor="#CC000000"
  android:shadowRadius="3"
  android:shadowDx="1"
  android:shadowDy="1"
  android:textSize="16sp"
  android:textStyle="bold" />
 <LinearLayout
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginTop="8dp"
  android:gravity="center_vertical"
  android:orientation="horizontal">
  <TextClock
   android:id="@+id/workly_datetime_time"
   android:layout_width="wrap_content"
   android:layout_height="wrap_content"
   android:format12Hour="hh:mm"
   android:format24Hour="HH:mm"
   android:includeFontPadding="false"
   android:textColor="#FFFFFFFF"
   android:shadowColor="#CC000000"
   android:shadowRadius="3"
   android:shadowDx="1"
   android:shadowDy="2"
   android:textSize="48sp"
   android:textStyle="bold"
   android:timeZone="Asia/Kolkata" />
  <TextClock
   android:id="@+id/workly_datetime_seconds"
   android:layout_width="wrap_content"
   android:layout_height="wrap_content"
   android:layout_marginStart="7dp"
   android:format12Hour="ss"
   android:format24Hour="ss"
   android:includeFontPadding="false"
   android:textColor="#FFFFFFFF"
   android:shadowColor="#CC000000"
   android:shadowRadius="2"
   android:shadowDx="1"
   android:shadowDy="1"
   android:textSize="20sp"
   android:timeZone="Asia/Kolkata" />
 </LinearLayout>
 <TextClock
  android:id="@+id/workly_datetime_date"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginTop="5dp"
  android:format12Hour="EEEE, dd MMMM yyyy"
  android:format24Hour="EEEE, dd MMMM yyyy"
  android:includeFontPadding="false"
  android:textColor="#FFFFFFFF"
  android:shadowColor="#CC000000"
  android:shadowRadius="2"
  android:shadowDx="1"
  android:shadowDy="1"
  android:textSize="14sp"
  android:timeZone="Asia/Kolkata" />
 <LinearLayout
  android:id="@+id/workly_festival_open"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginTop="12dp"
  android:gravity="center_vertical"
  android:orientation="vertical">
  <LinearLayout
   android:id="@+id/workly_festival_row_1"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:gravity="center_vertical"
   android:minHeight="44dp"
   android:orientation="horizontal"
   android:visibility="gone">
   <TextView
    android:id="@+id/workly_festival_icon"
    android:layout_width="34dp"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:text="🎉"
    android:textColor="#FFFFFFFF"
    android:textSize="23sp" />
   <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="7dp"
    android:layout_weight="1"
    android:orientation="vertical">
    <TextView
     android:id="@+id/workly_festival_name"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:ellipsize="end"
     android:maxLines="2"
     android:text="Festival"
     android:textColor="#FFFFFFFF"
     android:shadowColor="#CC000000"
     android:shadowRadius="3"
     android:shadowDx="1"
     android:shadowDy="1"
     android:textSize="19sp"
     android:textStyle="bold" />
    <TextView
     android:id="@+id/workly_festival_date"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:visibility="gone" />
   </LinearLayout>
  </LinearLayout>
  <LinearLayout
   android:id="@+id/workly_festival_row_2"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:layout_marginTop="3dp"
   android:gravity="center_vertical"
   android:minHeight="40dp"
   android:orientation="horizontal"
   android:visibility="gone">
   <TextView
    android:layout_width="34dp"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:text="🎉"
    android:textColor="#FFFFFFFF"
    android:textSize="23sp" />
   <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="7dp"
    android:layout_weight="1"
    android:orientation="vertical">
    <TextView
     android:id="@+id/workly_festival_name_2"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:ellipsize="end"
     android:maxLines="2"
     android:textColor="#FFFFFFFF"
     android:shadowColor="#CC000000"
     android:shadowRadius="3"
     android:shadowDx="1"
     android:shadowDy="1"
     android:textSize="19sp"
     android:textStyle="bold" />
    <TextView
     android:id="@+id/workly_festival_date_2"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:visibility="gone" />
   </LinearLayout>
  </LinearLayout>
 </LinearLayout>
</LinearLayout>
