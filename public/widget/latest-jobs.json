{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.6",
  "body": [
    {
      "type": "TextBlock",
      "text": "Latest Jobs",
      "weight": "Bolder",
      "size": "Medium",
      "wrap": true
    },
    {
      "type": "Container",
      "$data": "${jobs}",
      "items": [
        {
          "type": "TextBlock",
          "text": "${title}",
          "weight": "Bolder",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "${company} - ${type}",
          "spacing": "None",
          "isSubtle": true,
          "wrap": true
        },
        {
          "type": "ActionSet",
          "actions": [
            {
              "type": "Action.OpenUrl",
              "title": "Apply Now",
              "url": "https://worklyindia.devs.surf/jobs"
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": " ",
          "separator": true
        }
      ]
    }
  ]
}
