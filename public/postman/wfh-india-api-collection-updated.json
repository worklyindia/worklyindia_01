{
  "info": {
    "name": "Workly India API - Complete Collection",
    "description": "Complete API collection for Workly India platform including boost, extend, and application endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "value",
        "value": "{{api_key}}",
        "type": "string"
      },
      {
        "key": "key",
        "value": "X-Api-Key",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://jubwzelupbntbetpajqb.supabase.co/functions/v1",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "your_api_key_here",
      "type": "string"
    },
    {
      "key": "job_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Job Management",
      "item": [
        {
          "name": "Search Jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/jobs-search?search_query=developer&location=bangalore&limit=10",
              "host": ["{{base_url}}"],
              "path": ["jobs-search"],
              "query": [
                {
                  "key": "search_query",
                  "value": "developer"
                },
                {
                  "key": "location",
                  "value": "bangalore"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Job Details by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/jobs-search?job_id={{job_id}}",
              "host": ["{{base_url}}"],
              "path": ["jobs-search"],
              "query": [
                {
                  "key": "job_id",
                  "value": "{{job_id}}",
                  "description": "UUID of the job to fetch"
                }
              ]
            },
            "description": "Fetch complete details for a specific job including company info, skills, requirements, benefits, videos, and all metadata"
          }
        },
        {
          "name": "Boost Job with Wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_id\": \"{{job_id}}\",\n  \"boost_package_id\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/jobs-boost-wallet",
              "host": ["{{base_url}}"],
              "path": ["jobs-boost-wallet"]
            },
            "description": "Boost job using wallet points. Package IDs: 1 (100pts/week), 2 (200pts/week), 3 (300pts/week)"
          }
        },
        {
          "name": "Boost Job (API Key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_id\": \"{{job_id}}\",\n  \"boost_level\": 1,\n  \"duration_days\": 7\n}"
            },
            "url": {
              "raw": "{{base_url}}/jobs-boost",
              "host": ["{{base_url}}"],
              "path": ["jobs-boost"]
            },
            "description": "Boost job via API key. Boost levels: 1-3, Duration: 7, 14, or 30 days"
          }
        },
        {
          "name": "Extend Job with Wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_id\": \"{{job_id}}\",\n  \"duration_months\": 3\n}"
            },
            "url": {
              "raw": "{{base_url}}/wallet-job-extension",
              "host": ["{{base_url}}"],
              "path": ["wallet-job-extension"]
            },
            "description": "Extend job duration using wallet (50 points/month). Durations: 1, 2, 3, or 6 months"
          }
        },
        {
          "name": "Extend Job (API Key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_id\": \"{{job_id}}\",\n  \"duration_months\": 3\n}"
            },
            "url": {
              "raw": "{{base_url}}/jobs-extend",
              "host": ["{{base_url}}"],
              "path": ["jobs-extend"]
            },
            "description": "Extend job duration via API key. Durations: 1, 2, 3, or 6 months"
          }
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "Submit Application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_id\": \"{{job_id}}\",\n  \"full_name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"+91-9876543210\",\n  \"resume_url\": \"https://example.com/resume.pdf\",\n  \"cover_letter\": \"I am excited to apply...\",\n  \"years_of_experience\": 5,\n  \"current_location\": \"Bangalore\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/applications-submit",
              "host": ["{{base_url}}"],
              "path": ["applications-submit"]
            },
            "description": "Submit a job application"
          }
        }
      ]
    }
  ]
}