{
  "info": {
    "name": "Workly India API Collection",
    "description": "Complete API collection for Workly India - Remote job platform API. Includes all endpoints for jobs, companies, applications, and webhooks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "value",
        "value": "{{api_key}}",
        "type": "string"
      },
      {
        "key": "key",
        "value": "X-Api-Key",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://jubwzelupbntbetpajqb.supabase.co/functions/v1",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "your_api_key_here",
      "type": "string"
    },
    {
      "key": "job_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Search Jobs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/jobs-search?keyword=developer&location=bangalore&job_type=full_time&salary_min=50000&limit=10&offset=0",
              "host": ["{{base_url}}"],
              "path": ["jobs-search"],
              "query": [
                {
                  "key": "search_query",
                  "value": "developer",
                  "description": "Search query for job title, description, or company name"
                },
                {
                  "key": "location",
                  "value": "bangalore",
                  "description": "Job location"
                },
                {
                  "key": "job_type",
                  "value": "full_time",
                  "description": "full_time, part_time, contract, internship"
                },
                {
                  "key": "salary_min",
                  "value": "50000",
                  "description": "Minimum salary filter"
                },
                {
                  "key": "salary_max",
                  "value": "150000",
                  "description": "Maximum salary filter",
                  "disabled": true
                },
                {
                  "key": "experience_level",
                  "value": "mid",
                  "description": "entry, mid, senior",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Number of results (max 100)"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Pagination offset"
                }
              ]
            },
            "description": "Search and filter remote jobs with various criteria"
          },
          "response": []
        },
        {
          "name": "Create Job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Senior React Developer\",\n  \"description\": \"We are looking for an experienced React developer to join our remote team.\",\n  \"location\": \"Remote (India)\",\n  \"job_type\": \"full_time\",\n  \"salary_range\": \"₹8-15 LPA\",\n  \"experience_level\": \"mid\",\n  \"skills\": [\"React\", \"TypeScript\", \"Node.js\", \"Tailwind CSS\"],\n  \"application_deadline\": \"2025-12-31\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/jobs-create",
              "host": ["{{base_url}}"],
              "path": ["jobs-create"]
            },
            "description": "Create a new job posting (requires company owner authentication)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Companies",
      "item": [
        {
          "name": "List Companies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/companies-list?search=tech&industry=technology&size=medium&limit=20&offset=0",
              "host": ["{{base_url}}"],
              "path": ["companies-list"],
              "query": [
                {
                  "key": "search",
                  "value": "tech",
                  "description": "Search company name or description"
                },
                {
                  "key": "industry",
                  "value": "technology",
                  "description": "Filter by industry"
                },
                {
                  "key": "size",
                  "value": "medium",
                  "description": "small, medium, large, enterprise"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Number of results"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Pagination offset"
                }
              ]
            },
            "description": "Get list of companies with optional filters"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "Submit Application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_id\": \"{{job_id}}\",\n  \"full_name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"+91-9876543210\",\n  \"resume_url\": \"https://example.com/resumes/john-doe.pdf\",\n  \"cover_letter\": \"I am excited to apply for this position.\",\n  \"years_of_experience\": 5,\n  \"current_location\": \"Bangalore, India\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/applications-submit",
              "host": ["{{base_url}}"],
              "path": ["applications-submit"]
            },
            "description": "Submit a job application"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "List Webhooks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/webhook-register",
              "host": ["{{base_url}}"],
              "path": ["webhook-register"]
            },
            "description": "Get all registered webhooks for your account"
          },
          "response": []
        },
        {
          "name": "Register Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://your-domain.com/webhooks/workly-india\",\n  \"events\": [\"job.application.created\", \"job.boost.activated\"],\n  \"description\": \"Production webhook for application notifications\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/webhook-register",
              "host": ["{{base_url}}"],
              "path": ["webhook-register"]
            },
            "description": "Register a new webhook endpoint"
          },
          "response": []
        },
        {
          "name": "Delete Webhook",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/webhook-register?webhook_id={{webhook_id}}",
              "host": ["{{base_url}}"],
              "path": ["webhook-register"],
              "query": [
                {
                  "key": "id",
                  "value": "{{webhook_id}}",
                  "description": "ID of webhook to delete"
                }
              ]
            },
            "description": "Delete a registered webhook"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health & Monitoring",
      "item": [
        {
          "name": "Check API Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/check-api-health",
              "host": ["{{base_url}}"],
              "path": ["check-api-health"]
            },
            "description": "Check API health status and uptime"
          },
          "response": []
        }
      ]
    }
  ]
}